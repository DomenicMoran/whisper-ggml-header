{
  "name": "whisper-ggml-header",
  "version": "1.0.0",
  "description": "Read and validate the header of a Whisper GGML model. Catches the n_text_ctx=1024 mis-conversion that makes whisper.cpp refuse to load a file. No dependencies.",
  "keywords": [
    "whisper",
    "ggml",
    "whisper.cpp",
    "model",
    "validation",
    "n_text_ctx",
    "cli"
  ],
  "license": "MIT",
  "author": "Domenic Moran",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DomenicMoran/whisper-ggml-header.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "whisper-ggml-header": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/DomenicMoran/whisper-ggml-header#readme",
  "bugs": {
    "url": "https://github.com/DomenicMoran/whisper-ggml-header/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
